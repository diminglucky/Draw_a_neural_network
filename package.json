{
  "name": "synapse-studio",
  "version": "0.3.0",
  "description": "LLM-driven neural network architecture compiler with native Visio rendering",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win",
    "dist": "electron-builder",
    "test": "node --import ./test-setup.mjs --test",
    "block:acceptance": "node scripts/render-block-acceptance.mjs",
    "block:plan-audit": "node scripts/render-block-acceptance.mjs --fixture=all --plan-only",
    "scene:preview": "node scripts/render-scene-preview.mjs --fixture=all"
  },
  "build": {
    "appId": "com.synapse.studio",
    "productName": "Synapse Studio",
    "files": [
      "**/*",
      "!**/*.test.mjs",
      "!tmp/**",
      "!artifacts/**",
      "!docs/**",
      "!llm-config.json",
      "!*.md"
    ],
    "extraResources": [
      {
        "from": "visio-bridge.ps1",
        "to": "visio-bridge.ps1"
      },
      {
        "from": "visio-create-empty.ps1",
        "to": "visio-create-empty.ps1"
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "*.py"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "onnx-proto": "^8.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "protobufjs": "8.8.0"
  }
}
