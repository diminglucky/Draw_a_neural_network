# Foundation API
NODE_ENV=development
PORT=4180
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_DRIVER=memory
DATABASE_URL=postgres://synapse:synapse-local-only@127.0.0.1:54329/synapse_studio
LEASE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
REQUIRE_DEVICE_PROOF=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-local-admin-password

# Static client/server
FOUNDATION_API_URL=http://127.0.0.1:4180
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
