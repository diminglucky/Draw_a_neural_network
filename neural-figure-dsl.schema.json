{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/neural-figure-dsl/v1/schema.json",
  "title": "Neural Figure DSL",
  "type": "object",
  "required": ["version", "primitives"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": "neural-figure-dsl/v1" },
    "title": { "type": "string" },
    "direction": { "enum": ["left-to-right", "top-to-bottom"] },
    "plannerVersion": { "type": "string" },
    "sourceGraphVersion": { "type": "string" },
    "sourceCanonicalModel": { "type": "object" },
    "primitives": {
      "type": "array",
      "items": { "$ref": "#/$defs/primitive" }
    },
    "connectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/connector" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "styleTokens": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "primitive": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "tensor_box",
            "right_banded_tensor",
            "dense_layer",
            "layer_stack",
            "group_box",
            "anchor_connector"
          ]
        },
        "options": { "type": "object" },
        "sourceNodeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "connector": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceEdgeId": { "type": "string" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "routeClass": {
          "enum": ["main-flow", "bypass", "state", "conditional", "cross-scale"]
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["primitiveId", "anchor"],
      "additionalProperties": false,
      "properties": {
        "primitiveId": { "type": "string", "minLength": 1 },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "options"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "group_box" },
        "options": { "type": "object" },
        "sourceNodeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
